generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Filial {
  id         String    @id @default(uuid())
  nome       String
  cidade     String?
  criadoEm   DateTime  @default(now())
  usuarios   Usuario[]
  motoristas Driver[]
  pedidos    Order[]
  rotas      Route[]
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     String
  filialId  String?
  filial    Filial?  @relation(fields: [filialId], references: [id])
  criadoEm  DateTime @default(now())
}

model Order {
  id                    String    @id @default(uuid())
  codigoRastreio        String    @unique
  destinatarioNome      String
  destinatarioTelefone  String
  enderecoColeta        String
  enderecoEntrega       String
  janelaEntrega         String
  status                String    @default("recebido")
  latitude              Float?
  longitude             Float?
  localizacaoAproximada Boolean   @default(false)
  comprovanteTipo       String?
  comprovanteUrl        String?
  comprovanteData       DateTime?
  filialId              String
  filial                Filial    @relation(fields: [filialId], references: [id])
  criadoEm              DateTime  @default(now())
}

model Driver {
  id       String   @id @default(uuid())
  nome     String
  telefone String
  veiculo  String?
  filialId String
  filial   Filial   @relation(fields: [filialId], references: [id])
  criadoEm DateTime @default(now())
}

model Route {
  id               String   @id @default(uuid())
  driverId         String?
  distanciaTotalKm Float
  paradas          Json
  status           String   @default("planejada")
  filialId         String
  filial           Filial   @relation(fields: [filialId], references: [id])
  criadoEm         DateTime @default(now())
}
